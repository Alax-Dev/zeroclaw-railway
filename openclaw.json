{
  "$schema": "https://docs.openclaw.ai/schema/openclaw.json",
  "gateway": {
    "mode": "local"
  },
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "model": {
        "primary": "nim/moonshotai/kimi-k2.6",
        "fallbacks": [
          "nim/deepseek-ai/deepseek-v4-pro",
          "github-models/openai/gpt-5",
          "github-models/xai/grok-3",
          "nim/qwen/qwen3.5-122b-a10b",
          "nim/zai-org/glm-5"
        ]
      },
      "imageModel": {
        "primary": "nim/stabilityai/stable-diffusion-3_5-large",
        "fallbacks": [
          "nim/black-forest-labs/flux_2-klein-4b"
        ]
      },
      "models": {
        "nim/deepseek-ai/deepseek-v4-pro": {
          "alias": "deepseek"
        },
        "nim/zai-org/glm-5": {
          "alias": "glm"
        },
        "nim/qwen/qwen3.5-122b-a10b": {
          "alias": "qwen"
        },
        "nim/qwen/qwen3-coder-480b-a35b-instruct": {
          "alias": "qwen-coder"
        },
        "nim/microsoft/phi-4-mini-instruct": {
          "alias": "phi"
        },
        "copilot/gpt-4o": {
          "alias": "copilot-gpt4o"
        },
        "nim/stabilityai/stable-diffusion-3_5-large": {
          "alias": "sd"
        },
        "nim/black-forest-labs/flux_2-klein-4b": {
          "alias": "flux"
        },
        "github-models/openai/gpt-5": {
          "alias": "gpt5"
        },
        "github-models/xai/grok-3": {
          "alias": "grok"
        },
        "nim/moonshotai/kimi-k2.6": {
          "alias": "kimi"
        },
        "copilot/claude-3.5-haiku": {
          "alias": "copilot-haiku"
        },
        "copilot/gpt-4o-mini": {
          "alias": "copilot-gpt5mini"
        },
        "copilot/claude-sonnet-4": {
          "alias": "copilot-sonnet"
        }
      }
    },
    "list": [
      {
        "id": "main",
        "identity": {
          "emoji": "⚡",
          "name": "Zeroclaw"
        }
      }
    ]
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "dmPolicy": "allowlist",
      "allowFrom": [
        "${TELEGRAM_ADMIN_ID}"
      ],
      "streaming": "partial",
      "linkPreview": false,
      "textChunkLimit": 4000,
      "chunkMode": "newline",
      "pollingStallThresholdMs": 120000,
      "timeoutSeconds": 90,
      "commands": {
        "native": true,
        "nativeSkills": true
      },
      "capabilities": {
        "inlineButtons": "all"
      },
      "actions": {
        "sendMessage": true,
        "deleteMessage": true,
        "reactions": true,
        "sticker": true
      },
      "ackReaction": "⚡",
      "network": {
        "autoSelectFamily": false,
        "dnsResultOrder": "ipv4first"
      },
      "retry": {
        "attempts": 3,
        "minDelayMs": 1000,
        "maxDelayMs": 5000,
        "jitter": 0.1
      },
      "historyLimit": 50
    }
  },
  "commands": {
    "text": true,
    "bash": true,
    "bashForegroundMs": 5000,
    "config": true,
    "debug": true,
    "restart": true
  },
  "tools": {
    "exec": {
      "host": "gateway",
      "security": "full",
      "ask": "off"
    },
    "web": {
      "search": {
        "provider": "brave"
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "nim": {
        "baseUrl": "https://integrate.api.nvidia.com/v1",
        "apiKey": "${NVIDIA_NIM_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "deepseek-ai/deepseek-v4-pro",
            "name": "DeepSeek V4 Pro",
            "reasoning": true,
            "input": [
              "text"
            ],
            "contextWindow": 1048576,
            "maxTokens": 16384
          },
          {
            "id": "zai-org/glm-5",
            "name": "GLM-5.1",
            "reasoning": false,
            "input": [
              "text"
            ],
            "contextWindow": 131072,
            "maxTokens": 8192
          },
          {
            "id": "qwen/qwen3.5-122b-a10b",
            "name": "Qwen 3.5 122B",
            "reasoning": true,
            "input": [
              "text"
            ],
            "contextWindow": 131072,
            "maxTokens": 8192
          },
          {
            "id": "qwen/qwen3-coder-480b-a35b-instruct",
            "name": "Qwen 3 Coder 480B",
            "reasoning": true,
            "input": [
              "text"
            ],
            "contextWindow": 131072,
            "maxTokens": 16384
          },
          {
            "id": "microsoft/phi-4-mini-instruct",
            "name": "Phi 4 Mini",
            "reasoning": false,
            "input": [
              "text"
            ],
            "contextWindow": 131072,
            "maxTokens": 8192
          },
          {
            "id": "moonshotai/kimi-k2.6",
            "name": "Kimi K2.6",
            "reasoning": true,
            "input": [
              "text"
            ],
            "contextWindow": 131072,
            "maxTokens": 16384
          },
          {
            "id": "stabilityai/stable-diffusion-3_5-large",
            "name": "Stable Diffusion 3.5 Large",
            "reasoning": false,
            "input": [
              "text"
            ],
            "contextWindow": 4096,
            "maxTokens": 4096
          },
          {
            "id": "black-forest-labs/flux_2-klein-4b",
            "name": "FLUX 2 Klein",
            "reasoning": false,
            "input": [
              "text"
            ],
            "contextWindow": 4096,
            "maxTokens": 4096
          }
        ]
      },
      "github-models": {
        "baseUrl": "https://models.github.ai/inference",
        "apiKey": "${GITHUB_TOKEN}",
        "api": "openai-completions",
        "models": [
          {
            "id": "openai/gpt-5",
            "name": "GPT-5",
            "reasoning": true,
            "input": [
              "text",
              "image"
            ],
            "contextWindow": 128000,
            "maxTokens": 16384,
            "compat": {
              "maxTokensField": "max_completion_tokens"
            }
          },
          {
            "id": "xai/grok-3",
            "name": "Grok 3",
            "reasoning": true,
            "input": [
              "text"
            ],
            "contextWindow": 131072,
            "maxTokens": 8192,
            "compat": {
              "maxTokensField": "max_completion_tokens"
            }
          }
        ]
      },
      "copilot": {
        "baseUrl": "http://localhost:8789/v1",
        "apiKey": "copilot-proxy",
        "api": "openai-completions",
        "models": [
          {
            "id": "claude-3.5-haiku",
            "name": "Claude 3.5 Haiku (Copilot)",
            "reasoning": false,
            "input": [
              "text"
            ],
            "contextWindow": 200000,
            "maxTokens": 8192
          },
          {
            "id": "gpt-4o",
            "name": "GPT-4o (Copilot)",
            "reasoning": false,
            "input": [
              "text",
              "image"
            ],
            "contextWindow": 128000,
            "maxTokens": 16384
          },
          {
            "id": "gpt-4o-mini",
            "name": "GPT-4o Mini (Copilot)",
            "reasoning": false,
            "input": [
              "text"
            ],
            "contextWindow": 128000,
            "maxTokens": 16384
          },
          {
            "id": "claude-sonnet-4",
            "name": "Claude Sonnet 4 (Copilot)",
            "reasoning": true,
            "input": [
              "text"
            ],
            "contextWindow": 200000,
            "maxTokens": 16384
          }
        ]
      }
    }
  }
}