# ============================================
# ZEROCKLA RAILWAY - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# Or set these in Railway dashboard under Variables

# ---- REQUIRED ----

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram numeric user ID (get from @userinfobot)
TELEGRAM_ADMIN_ID=your_numeric_user_id

# ---- AI PROVIDERS (at least one required) ----

# NVIDIA NIM API Key (get from https://build.nvidia.com)
# Models: Kimi-K2.6, DeepSeek-V4-Pro, GLM-5.1, Qwen3.5, Qwen3-Coder, Phi-4
# Image Models: Stable Diffusion 3.5, FLUX 2
NVIDIA_NIM_API_KEY=nvapi-your_key_here

# GitHub Token (get from https://github.com/settings/tokens)
# Models: GPT-5, Grok-3
GITHUB_TOKEN=ghp_your_token_here

# ---- OPTIONAL ----

# Brave Search API Key (for web search capability)
BRAVE_API_KEY=your_brave_key_here
